  "guides": {
    "apple": {
      "intro": "En iPhone la opción puede estar gestionada automáticamente por el operador; no siempre existe un interruptor específico de VoLTE.",
      "variants": [
        {
          "id": "ios-new",
          "label": "iOS reciente",
          "steps": [
            "Abre Ajustes en el iPhone.",
            "Entra en Datos móviles.",
            "Si utilizas dos líneas, elige la línea de voz que quieres configurar.",
            "Entra en Opciones de datos móviles si se muestra y después pulsa Voz y datos.",
            "Selecciona 4G/LTE o 5G según las opciones disponibles. Si aparece VoLTE, actívalo."
          ],
          "note": "En algunos iPhone la opción VoLTE no se muestra por separado. Si solo ves opciones de Voz y datos, no significa que el teléfono carezca de VoLTE."
        },
        {
          "id": "ios-old",
          "label": "iOS anterior",
          "steps": [
            "Abre Ajustes.",
            "Pulsa Datos móviles y entra en Opciones.",
            "Accede a Voz y datos.",
            "Selecciona LTE/4G y, si aparece la opción de voz LTE o VoLTE, elige Voz y datos o activa VoLTE."
          ],
          "note": "Las opciones concretas dependen del operador y de la versión de iOS."
        }
      ],
      "note": "Si no aparece VoLTE, revisa si tu operador lo habilita para tu línea. La ausencia del interruptor en iOS no demuestra que esté desactivado."
    },
    "samsung": {
      "intro": "En Samsung Galaxy con One UI, la ruta puede cambiar con la versión del software.",
      "variants": [
        {
          "id": "toggle",
          "label": "Con interruptor",
          "steps": [
            "Abre Ajustes.",
            "Entra en Conexiones.",
            "Pulsa Redes móviles.",
            "Si aparece Llamadas VoLTE (o Llamadas VoLTE SIM 1 / SIM 2), activa el interruptor de la SIM correspondiente."
          ],
          "note": "Si utilizas dos SIM, comprueba la línea adecuada."
        },
        {
          "id": "automatic",
          "label": "Sin interruptor",
          "steps": [
            "Abre Ajustes y entra en Conexiones.",
            "Selecciona Redes móviles y comprueba que el modo de red permita 4G/LTE.",
            "Si no ves Llamadas VoLTE, es posible que el sistema la gestione automáticamente.",
            "Mantén actualizado el sistema y consulta con tu operador si la línea tiene habilitadas las llamadas 4G."
          ],
          "note": "En determinadas versiones recientes de One UI el interruptor ya no está disponible: no es necesario forzarlo ni instalar aplicaciones."
        }
      ],
      "note": "El menú puede variar según la región, el modelo y el operador."
    },
    "xiaomi": {
      "intro": "La configuración varía entre MIUI y HyperOS. Elige la interfaz que veas en Ajustes.",
      "variants": [
        {
          "id": "hyperos",
          "label": "HyperOS / interfaz reciente",
          "steps": [
            "Abre Ajustes.",
            "Entra en Redes móviles.",
            "Selecciona la tarjeta SIM con la que llamas.",
            "Busca Llamadas 4G o Usar VoLTE y actívalo si aparece."
          ],
          "note": "Si no encuentras la opción, puede estar gestionada automáticamente o no estar habilitada por el operador."
        },
        {
          "id": "miui",
          "label": "MIUI",
          "steps": [
            "Abre Ajustes.",
            "Entra en Tarjetas SIM y redes móviles.",
            "Selecciona la tarjeta SIM que utilizas para las llamadas.",
            "Busca Usar VoLTE o Llamadas VoLTE y activa el interruptor."
          ],
          "note": "En versiones de MIUI más antiguas puede aparecer un nombre o menú ligeramente distinto."
        }
      ],
      "note": "No marques códigos de servicio ni cambies ajustes avanzados si no estás seguro de la variante exacta de tu equipo."
    },
    "google": {
      "intro": "En Google Pixel, VoLTE puede estar habilitado de forma predeterminada según el operador.",
      "variants": [
        {
          "id": "pixel",
          "label": "Android / Pixel",
          "steps": [
            "Abre Ajustes.",
            "Entra en Redes e Internet.",
            "Pulsa SIMs y selecciona tu línea si tienes varias.",
            "Busca VoLTE o Llamadas 4G y actívalo si aparece."
          ],
          "note": "Si no hay un interruptor, el operador podría administrarlo automáticamente."
        }
      ],
      "note": "La disponibilidad de VoLTE depende también de la configuración de la red de tu compañía."
    },
    "oppo": {
      "intro": "En teléfonos OPPO, selecciona la versión de ColorOS que tengas instalada.",
      "variants": [
        {
          "id": "coloros12",
          "label": "ColorOS 12 o superior",
          "steps": [
            "Abre Ajustes.",
            "Entra en Red móvil.",
            "Elige la SIM que usas para llamar.",
            "Activa Llamadas VoLTE, si aparece."
          ],
          "note": "La opción podría estar activada por defecto o no mostrarse, según operador."
        },
        {
          "id": "coloros11",
          "label": "ColorOS 11 o anterior",
          "steps": [
            "Abre Ajustes.",
            "Entra en Tarjeta SIM y datos móviles (o SIM dual y red móvil, según versión).",
            "Selecciona la SIM.",
            "Activa Llamadas VoLTE, si está disponible."
          ],
          "note": "En ColorOS antiguos los nombres de los menús pueden variar."
        }
      ],
      "note": "No ver el interruptor no demuestra incompatibilidad: el operador y la versión de software pueden ocultarlo."
    },
    "motorola": {
      "intro": "En Motorola, las opciones suelen encontrarse dentro de la configuración de la SIM y de la red móvil.",
      "variants": [
        {
          "id": "moto-current",
          "label": "Android reciente",
          "steps": [
            "Abre Ajustes.",
            "Selecciona Redes e Internet.",
            "Entra en SIMs o Red móvil y elige la línea correspondiente.",
            "Busca Llamadas 4G o VoLTE y actívalo si aparece."
          ],
          "note": "En algunos equipos Motorola no aparece un interruptor independiente."
        },
        {
          "id": "moto-older",
          "label": "Android anterior",
          "steps": [
            "Abre Ajustes.",
            "Entra en Redes e Internet.",
            "Selecciona Red móvil.",
            "Busca Llamadas 4G (4G Calling) y activa esa opción, si está disponible."
          ],
          "note": "Los menús exactos varían según la versión y región."
        }
      ],
      "note": "Mantén actualizado el software del teléfono y consulta a tu operador si no aparece la opción."
    },
    "huawei": {
      "intro": "En Huawei con EMUI, las llamadas 4G pueden configurarse dentro de los ajustes de datos móviles.",
      "variants": [
        {
          "id": "emui",
          "label": "EMUI",
          "steps": [
            "Abre Ajustes.",
            "Entra en Redes móviles.",
            "Pulsa Datos móviles.",
            "Busca Llamadas VoLTE y activa la opción si aparece para tu SIM."
          ],
          "note": "En versiones o configuraciones de operador donde no se ve el interruptor, VoLTE puede administrarse automáticamente."
        }
      ],
      "note": "Si tienes varias SIM, comprueba la línea de voz correcta."
    }
  }
}
